		sourceColumn: [FimDeSemana]

		annotation SummarizationSetBy = Automatic

	partition dCalendario = calculated
		mode: import
		source = ```
				VAR MenorData = MIN('spotify_artist_streaming_2020_2025'[release_date])
				VAR MaiorData = MAX('spotify_artist_streaming_2020_2025'[release_date])
				VAR DataInicial = DATE(YEAR(IF(ISBLANK(MenorData), DATE(2020,1,1), MenorData)), 1, 1)
				VAR DataFinal = DATE(YEAR(IF(ISBLANK(MaiorData), TODAY(), MaiorData)), 12, 31)
				RETURN
				    ADDCOLUMNS(
				        CALENDAR(DataInicial, DataFinal),
				        "Ano", YEAR([Date]),
				        "MesNumero", MONTH([Date]),
				        "Mes", FORMAT([Date], "mmmm", "pt-BR"),
				        "TrimestreNumero", QUARTER([Date]),
				        "Trimestre", "Q" & FORMAT(QUARTER([Date]), "0"),
				        "AnoMes", FORMAT([Date], "mmm/yyyy", "pt-BR"),
				        "AnoMesNumero", YEAR([Date]) * 100 + MONTH([Date]),
				        "Dia", DAY([Date]),
				        "DiaSemanaNumero", WEEKDAY([Date], 2),
				        "DiaSemana", FORMAT([Date], "dddd", "pt-BR"),
				        "SemanaAno", WEEKNUM([Date], 2),
				        "FimDeSemana", IF(WEEKDAY([Date], 2) >= 6, "Sim", "Não")
				    )
				```